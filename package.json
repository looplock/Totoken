{
  "name": "totoken-ui",
  "private": true,
  "version": "0.1.0",
  "description": "A Tauri desktop application for inspecting local AI coding tool usage and model activity.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "homepage": "https://github.com/looplock/Totoken",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/looplock/Totoken.git"
  },
  "bugs": {
    "url": "https://github.com/looplock/Totoken/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "rust:fmt": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "test": "node scripts/check_i18n_keys.mjs && node scripts/check_css_conventions.mjs && node scripts/check_frontend_smoke.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --no-bundle",
    "tauri:build:mac": "tauri build --bundles dmg",
    "tauri:build:linux": "tauri build --bundles deb,appimage"
  },
  "dependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.4.10"
  }
}
